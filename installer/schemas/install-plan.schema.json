{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "target_disk"
  ],
  "properties": {
    "target_disk": {
      "type": "string",
      "pattern": "^/dev/"
    },
    "encryption": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "user": {
      "type": "object"
    },
    "choices": {
      "type": "object"
    },
    "confirm_typed": {
      "type": "string"
    }
  }
}
