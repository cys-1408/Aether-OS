{
  "$schema": "http://json-schema.org/draft-2020-12/schema#",
  "$id": "aether://data/schemas/action-ledger-entry.schema.json",
  "$comment": "Canonical copy also mirrored at protocols/schemas/action-ledger-entry.schema.json",
  "title": "Action ledger entry",
  "version": 1,
  "type": "object",
  "required": ["entry_id", "ts", "state"],
  "properties": {
    "entry_id": {"type": "string"},
    "ts": {"type": "string"},
    "agent_request_id": {"type": "string"},
    "caller_uid": {"type": "integer"},
    "capability_id": {"type": "string"},
    "capability_version": {"type": "string"},
    "risk_class": {"type": "string"},
    "state": {
      "type": "string",
      "enum": ["requested", "authorized", "running", "completed", "failed",
               "cancelled", "partially_completed", "rolled_back"]
    },
    "parameters_redacted": {"type": "object"},
    "result_summary": {"type": "object"},
    "verified_result": {"type": "boolean"},
    "confirmation": {"type": "string", "enum": ["none", "policy", "user", "always"]},
    "undo": {
      "type": "object",
      "properties": {
        "supported": {"type": "boolean"},
        "method": {"type": ["string", "null"]},
        "executed": {"type": "boolean"}
      }
    },
    "retention_hint_days": {"type": "integer", "minimum": 1},
    "redaction_applied": {"type": "boolean"}
  }
}
