<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.aether.Notifications — documented interface contract.
  Transport v1: JSON-RPC 2.0 over unix socket /run/aether/notifications.sock
  (annotation org.aether.Socket below). Method names here map 1:1 to
  <Namespace.method> JSON-RPC methods (CONVENTIONS.md §4).
-->
<node name="/org/aether/Notifications">
  <interface name="org.aether.Notifications">
    <annotation name="org.aether.Socket" value="/run/aether/notifications.sock"/>
    <annotation name="org.aether.Transport" value="jsonrpc-uds-v1"/>
    <method name="notify">
      <arg name="payload" direction="in" type="s"/>
    </method>
    <method name="list">
      <arg name="filters" direction="in" type="s"/>
    </method>
    <method name="close">
      <arg name="id" direction="in" type="s"/>
    </method>
    <method name="history">
      <arg name="filters" direction="in" type="s"/>
    </method>
  </interface>
</node>
