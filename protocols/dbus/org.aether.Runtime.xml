<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.aether.Runtime — documented interface contract.
  Transport v1: JSON-RPC 2.0 over unix socket /run/aether/runtime.sock
  (annotation org.aether.Socket below). Method names here map 1:1 to
  <Namespace.method> JSON-RPC methods (CONVENTIONS.md §4).
-->
<node name="/org/aether/Runtime">
  <interface name="org.aether.Runtime">
    <annotation name="org.aether.Socket" value="/run/aether/runtime.sock"/>
    <annotation name="org.aether.Transport" value="jsonrpc-uds-v1"/>
    <method name="status">
      <arg name="status" direction="in" type="s"/>
    </method>
    <method name="profile">
      <arg name="profile" direction="in" type="s"/>
    </method>
    <method name="models_list">
      <arg name="filter" direction="in" type="s"/>
    </method>
    <method name="models_recommend">
      <arg name="task_class" direction="in" type="s"/>
    </method>
    <method name="download_start">
      <arg name="model_id" direction="in" type="s"/>
      <arg name="consent" direction="in" type="s"/>
    </method>
    <method name="download_status">
      <arg name="model_id" direction="in" type="s"/>
    </method>
    <method name="download_cancel">
      <arg name="model_id" direction="in" type="s"/>
    </method>
    <method name="model_remove">
      <arg name="model_id" direction="in" type="s"/>
    </method>
    <method name="warmup">
      <arg name="model_id" direction="in" type="s"/>
    </method>
    <method name="infer">
      <arg name="request_json" direction="in" type="s"/>
    </method>
    <method name="infer_stream">
      <arg name="request_json" direction="in" type="s"/>
    </method>
    <method name="backend_status">
      <arg name="params" direction="in" type="s"/>
    </method>
  </interface>
</node>
