<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.aether.SystemStatus — documented interface contract.
  Transport v1: JSON-RPC 2.0 over unix socket /run/aether/hardware-probe.sock
  (annotation org.aether.Socket below). Method names here map 1:1 to
  <Namespace.method> JSON-RPC methods (CONVENTIONS.md §4).
-->
<node name="/org/aether/SystemStatus">
  <interface name="org.aether.SystemStatus">
    <annotation name="org.aether.Socket" value="/run/aether/hardware-probe.sock"/>
    <annotation name="org.aether.Transport" value="jsonrpc-uds-v1"/>
    <method name="summary">
      <arg name="params" direction="in" type="s"/>
    </method>
    <method name="cpu">
      <arg name="params" direction="in" type="s"/>
    </method>
    <method name="memory">
      <arg name="params" direction="in" type="s"/>
    </method>
    <method name="storage">
      <arg name="params" direction="in" type="s"/>
    </method>
    <method name="power">
      <arg name="params" direction="in" type="s"/>
    </method>
    <method name="profile">
      <arg name="params" direction="in" type="s"/>
    </method>
  </interface>
</node>
