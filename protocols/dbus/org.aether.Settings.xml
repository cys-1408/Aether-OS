<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.aether.Settings — documented interface contract.
  Transport v1: JSON-RPC 2.0 over unix socket /run/user/{uid}/aether/shell.sock
  (annotation org.aether.Socket below). Method names here map 1:1 to
  <Namespace.method> JSON-RPC methods (CONVENTIONS.md §4).
-->
<node name="/org/aether/Settings">
  <interface name="org.aether.Settings">
    <annotation name="org.aether.Socket" value="/run/user/{uid}/aether/shell.sock"/>
    <annotation name="org.aether.Transport" value="jsonrpc-uds-v1"/>
    <method name="read_setting">
      <arg name="key" direction="in" type="s"/>
    </method>
    <method name="change_setting">
      <arg name="key" direction="in" type="s"/>
      <arg name="value" direction="in" type="s"/>
    </method>
  </interface>
</node>
