<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  org.aether.Updates — documented interface contract.
  Transport v1: JSON-RPC 2.0 over unix socket /run/aether/updates.sock
  (annotation org.aether.Socket below). Method names here map 1:1 to
  <Namespace.method> JSON-RPC methods (CONVENTIONS.md §4).
-->
<node name="/org/aether/Updates">
  <interface name="org.aether.Updates">
    <annotation name="org.aether.Socket" value="/run/aether/updates.sock"/>
    <annotation name="org.aether.Transport" value="jsonrpc-uds-v1"/>
    <method name="check">
      <arg name="params" direction="in" type="s"/>
    </method>
    <method name="status">
      <arg name="params" direction="in" type="s"/>
    </method>
    <method name="download">
      <arg name="update_id" direction="in" type="s"/>
    </method>
    <method name="install">
      <arg name="update_id" direction="in" type="s"/>
    </method>
    <method name="history">
      <arg name="params" direction="in" type="s"/>
    </method>
  </interface>
</node>
