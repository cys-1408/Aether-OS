{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aether-os.org/schemas/intentfs-record.schema.json",
  "title": "File metadata, index status and the three concepts",
  "type": "object",
  "required": [
    "file_id",
    "filename",
    "path",
    "index_status"
  ],
  "properties": {
    "file_id": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "mime_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "size_bytes": {
      "type": [
        "integer",
        "null"
      ]
    },
    "mtime": {
      "type": [
        "number",
        "null"
      ]
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "extractor_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "index_status": {
      "enum": [
        "ready",
        "pending",
        "failed",
        "excluded",
        "pending-limited"
      ]
    },
    "concepts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 32
      }
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "search_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "privacy_scope": {
      "enum": [
        "user-local",
        "excluded",
        "removable-consented"
      ]
    },
    "indexed_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
