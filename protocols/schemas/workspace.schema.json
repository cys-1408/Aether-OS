{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aether-os.org/schemas/workspace.schema.json",
  "title": "Portable, versioned workspace state",
  "type": "object",
  "required": [
    "workspace_id",
    "name",
    "version"
  ],
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "windows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "agent_state": {
      "type": [
        "object",
        "null"
      ]
    },
    "restore_preview": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
