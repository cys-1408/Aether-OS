{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aether-os.org/schemas/hardware-profile.schema.json",
  "title": "Measured hardware facts (unknowns explicit)",
  "type": "object",
  "required": [
    "schema_version",
    "cpu",
    "memory",
    "storage",
    "network",
    "power"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "cpu": {
      "type": "object",
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "cores": {
          "type": [
            "integer",
            "null"
          ]
        },
        "threads": {
          "type": [
            "integer",
            "null"
          ]
        },
        "arch": {
          "type": [
            "string",
            "null"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "total_mb": {
          "type": [
            "integer",
            "null"
          ]
        },
        "available_mb": {
          "type": [
            "integer",
            "null"
          ]
        },
        "swap_total_mb": {
          "type": [
            "integer",
            "null"
          ]
        },
        "zram_mb": {
          "type": [
            "integer",
            "null"
          ]
        },
        "psi_mem_avg10": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "accelerators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "gpu",
              "npu",
              "unknown"
            ]
          },
          "vendor": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "driver": {
            "type": [
              "string",
              "null"
            ]
          },
          "vram_mb": {
            "type": [
              "integer",
              "null"
            ]
          },
          "unsupported_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "storage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "fstype": {
            "type": [
              "string",
              "null"
            ]
          },
          "mountpoint": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "health": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "network": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "mac": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "thermal": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "zone": {
            "type": "string"
          },
          "temp_c": {
            "type": [
              "number",
              "null"
            ]
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "power": {
      "type": "object",
      "properties": {
        "ac_online": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "battery": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "capacity_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "status": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "unknown_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
