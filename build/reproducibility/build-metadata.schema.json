{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aether-os.org/schemas/build-metadata.schema.json",
  "title": "Aether build metadata",
  "type": "object",
  "required": ["version", "host", "sources", "outputs"],
  "properties": {
    "version": {"type": "string"},
    "host": {"type": "object", "properties": {"arch": {"type": "string"}, "gcc": {"type": "string"}}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["name", "sha256"], "properties": {"name": {"type": "string"}, "sha256": {"type": "string"}}}},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["name", "sha256"], "properties": {"name": {"type": "string"}, "sha256": {"type": "string"}}}}
  }
}
