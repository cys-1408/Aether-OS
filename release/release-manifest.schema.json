{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aether-os.org/schemas/release-manifest.schema.json",
  "title": "Aether release manifest",
  "type": "object",
  "required": ["version", "generated_at", "artifacts", "components"],
  "properties": {
    "version": {"type": "string"},
    "generated_at": {"type": "string"},
    "kernel": {"type": "object"},
    "components": {"type": "array", "items": {"type": "string"}},
    "artifacts": {
      "type": "array",
      "items": {"type": "object", "required": ["name", "sha256"], "properties": {"name": {"type": "string"}, "sha256": {"type": "string"}, "size": {"type": "integer"}, "signed_by": {"type": "string"}}}
    },
    "signed_by": {"type": "string"},
    "note": {"type": "string"}
  }
}
