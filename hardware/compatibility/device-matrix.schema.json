{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["devices"],
  "properties": {
    "devices": {"type": "array", "items": {"type": "object",
      "required": ["class", "model", "status"],
      "properties": {"class": {"type": "string"}, "model": {"type": "string"},
                      "status": {"enum": ["tested", "expected", "problematic", "unsupported"]},
                      "notes": {"type": "string"}}}}
  }
}
