# fragment: namespaces-and-seccomp
# Policy: full namespace support for sandboxes and systemd; user namespaces
# enabled (sandboxed tooling relies on them); seccomp filter mandatory for the
# unit hardening baseline.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
