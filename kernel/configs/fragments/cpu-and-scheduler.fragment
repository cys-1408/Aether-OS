# fragment: cpu-and-scheduler
# Policy: desktop-class scheduling; group scheduling for the resource governor;
# dynamic preemption selected at boot (PREEMPT_DYNAMIC).
CONFIG_SMP=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_250=y
CONFIG_NR_CPUS=256
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_SCHEDSTATS=y
CONFIG_CPU_FREQ=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_JUMP_LABEL=y
CONFIG_MICROCODE=y
