# Network stack + common NICs (modules) + filtering
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLMVM=m
CONFIG_IWLWIFI=m
CONFIG_R8169=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_USB_USBNET=m
CONFIG_RFKILL=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
