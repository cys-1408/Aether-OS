# fragment: power-thermal
# Policy: battery/thermal reporting for power-manager; EFI variable access for
# the installer and bootloader tooling; efficient firmware interface.
CONFIG_THERMAL=y
CONFIG_POWER_SUPPLY=y
CONFIG_ACPI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_ESRT=y
CONFIG_EFIVAR_FS=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_MICROCODE=y
