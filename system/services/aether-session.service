[Unit]
Description=Aether session coordinator (greetd/sway launch)
Documentation=https://aether-os.org/docs
After=aether-firstboot.service

ConditionPathExists=/usr/libexec/aether

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/libexec/aether/session/session_manager.py
Restart=on-failure
RestartSec=2s
RuntimeDirectory=aether
RuntimeDirectoryMode=0755
UMask=007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=


[Install]
WantedBy=multi-user.target
