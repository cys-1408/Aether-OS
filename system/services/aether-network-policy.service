[Unit]
Description=Aether network policy and consent store
Documentation=https://aether-os.org/docs
After=NetworkManager.service
Wants=NetworkManager.service
ConditionPathExists=/usr/libexec/aether

[Service]
Type=simple
User=aether-hw
Group=aether-hw
ExecStart=/usr/bin/python3 /usr/libexec/aether/network-consent/main.py
Restart=on-failure
RestartSec=2s
RuntimeDirectory=aether
RuntimeDirectoryMode=0755
UMask=007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=


[Install]
WantedBy=multi-user.target
