[Unit]
Description=Aether recovery coordinator (recovery target)
Documentation=https://aether-os.org/docs
After=basic.target

ConditionPathExists=/usr/libexec/aether

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/libexec/aether/recovery/recovery-entry/recovery_main.py
Restart=on-failure
RestartSec=2s
RuntimeDirectory=aether
RuntimeDirectoryMode=0755
UMask=007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
StandardInput=tty-force
TTYPath=/dev/tty1

[Install]
WantedBy=multi-user.target
