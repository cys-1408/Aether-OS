[Unit]
Description=Aether hardware probe service
Documentation=https://aether-os.org/docs
After=systemd-udevd.service

ConditionPathExists=/usr/libexec/aether

[Service]
Type=simple
User=aether-hw
Group=aether-hw
ExecStart=/usr/bin/python3 /usr/libexec/aether/hardware-probe/main.py
Restart=on-failure
RestartSec=2s
RuntimeDirectory=aether
RuntimeDirectoryMode=0755
UMask=007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/run/aether

[Install]
WantedBy=multi-user.target
