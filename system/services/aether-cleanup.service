[Unit]
Description=Aether eligible cache/temp cleanup
Documentation=https://aether-os.org/docs
After=basic.target

ConditionPathExists=/usr/libexec/aether

[Service]
Type=simple
User=aether-health
Group=aether-health
ExecStart=/usr/bin/python3 /usr/libexec/aether/system/cleanup.py
Restart=on-failure
RestartSec=2s
RuntimeDirectory=aether
RuntimeDirectoryMode=0755
UMask=007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/cache /var/tmp /tmp

[Install]
WantedBy=multi-user.target
