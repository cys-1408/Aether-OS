[Unit]
Description=Aether signed update checker
Documentation=https://aether-os.org/docs
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/libexec/aether

[Service]
Type=simple
User=aether-health
Group=aether-health
ExecStart=/usr/bin/python3 /usr/libexec/aether/updater/update_checker.py --service
Restart=on-failure
RestartSec=2s
RuntimeDirectory=aether
RuntimeDirectoryMode=0755
UMask=007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=


[Install]
WantedBy=multi-user.target
