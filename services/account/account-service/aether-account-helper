#!/usr/bin/env bash
# Privileged account helper (polkit). STRICT argv — no shell interpolation.
# Usage: aether-account-helper create-user <username> <full_name> <yes|no>
#        aether-account-helper set-password <username>   (passwords via stdin)
#        aether-account-helper add-group <username> <wheel|users|aether-services>
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "must run as root (pkexec)" >&2; exit 77; }
cmd="${1:-}"; shift || true
case "$cmd" in
  create-user)
    [[ $# -eq 3 ]] || { echo "usage: create-user <username> <full_name> <yes|no>" >&2; exit 64; }
    user="$1"; full="$2"; admin="$3"
    [[ "$user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { echo "invalid username" >&2; exit 65; }
    [[ "$admin" == yes || "$admin" == no ]] || { echo "admin must be yes|no" >&2; exit 65; }
    groups="users"
    [[ "$admin" == yes ]] && groups="wheel,users"
    useradd -m -c "$full" -G "$groups" -s /bin/bash "$user"
    passwd --stdin "$user" 2>/dev/null || chpasswd
    echo "created $user"
    ;;
  set-password)
    [[ $# -eq 1 ]] || { echo "usage: set-password <username>" >&2; exit 64; }
    chpasswd
    ;;
  add-group)
    [[ $# -eq 2 ]] || { echo "usage: add-group <username> <group>" >&2; exit 64; }
    case "$2" in wheel|users|aether-services) ;; *) echo "group not managed" >&2; exit 65;; esac
    usermod -aG "$2" "$1"
    ;;
  *) echo "unknown command: $cmd" >&2; exit 64 ;;
esac
