  "type": "object",
  "required": ["id", "title", "due_utc", "created_at"],
  "properties": {
    "id": {"type": "integer"},
    "title": {"type": "string", "minLength": 1},
    "due_utc": {"type": "string"},
    "created_at": {"type": "string"},
    "notified": {"type": "boolean"}
  }
}
