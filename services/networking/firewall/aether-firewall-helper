#!/usr/bin/env bash
# Privileged firewall helper (polkit). STRICT argv.
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "must run as root (pkexec)" >&2; exit 77; }
cmd="${1:-}"; shift || true
DEFAULT=/etc/aether/firewall/default.nft
case "$cmd" in
  apply-default)
    command -v nft >/dev/null || { echo "nft missing" >&2; exit 69; }
    [[ -f "$DEFAULT" ]] || { echo "default rules missing" >&2; exit 66; }
    nft -f "$DEFAULT"
    ;;
  open-port)
    [[ $# -eq 2 ]] || { echo "usage: open-port <port> <tcp|udp>" >&2; exit 64; }
    port="$1"; proto="$2"
    [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || { echo "bad port" >&2; exit 65; }
    [[ "$proto" == tcp || "$proto" == udp ]] || { echo "bad proto" >&2; exit 65; }
    nft add rule inet aether input "$proto" dport "$port" accept
    ;;
  *) echo "unknown command" >&2; exit 64 ;;
esac
