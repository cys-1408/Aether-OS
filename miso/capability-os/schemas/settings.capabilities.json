{
  "group": "settings",
  "version": "1.0.0",
  "capabilities": [
    {
      "id": "read_setting",
      "version": "1.0.0",
      "provider": "agent-local",
      "risk_class": "read_only",
      "permission": "session",
      "timeout_s": 5,
      "idempotent": true,
      "side_effects": "none",
      "confirmation": "never",
      "input_schema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "value": {}
        }
      },
      "undo": {
        "supported": false,
        "method": null
      }
    },
    {
      "id": "change_setting",
      "version": "1.0.0",
      "provider": "agent-local",
      "risk_class": "write",
      "permission": "settings-write",
      "timeout_s": 10,
      "idempotent": false,
      "side_effects": "changes one registered setting (previous value recorded for undo)",
      "confirmation": "policy",
      "input_schema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "undo": {
        "supported": true,
        "method": "restore previous value"
      }
    }
  ]
}
